# Copy to .env and fill secrets. Never put real keys in this file.

# Local compose Postgres publishes 5433 on the host (avoids clashing with other
# Postgres installs on 5432). From the host, prefer the Docker network smoke:
#   docker compose up -d postgres
#   docker run --rm --network kalchas30_default -v "%cd%:/app" -w /app \
#     -e DATABASE_URL=postgresql://kalchas:kalchas@postgres:5432/kalchas \
#     ghcr.io/astral-sh/uv:python3.13-bookworm bash scripts/smoke_persist.sh
DATABASE_URL=postgresql://kalchas:kalchas@127.0.0.1:5433/kalchas
API_HOST=127.0.0.1
API_PORT=8000
# apiv3.apifootball.com — same provider as Kalchas 2.2
# API_FOOTBALL_KEY=
# FOOTBALL_API_BASE=https://apiv3.apifootball.com/
# FOOTBALL_REQUESTS_PER_HOUR=180
# TELEGRAM_TOKEN=
# SCANNER_ONCE=1
